# Base de dados (SQLite local). Para Postgres: postgresql://user:pass@host:5432/db
DATABASE_URL="file:./dev.db"

# Porta do servidor
PORT=4000

# Camada de IA: "mock" (default) ou "claude"
AI_PROVIDER=mock

# Necessário apenas quando AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
