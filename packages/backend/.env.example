# Base de dados PostgreSQL.
# Produção: preenchida automaticamente pelo Render (ver render.yaml).
# Dev local: aponta para um Postgres local, por exemplo via Docker —
#   docker run --name service01-db -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=service01 -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:dev@localhost:5432/service01"

# Porta do servidor (em produção o Render define PORT automaticamente)
PORT=4000

# Camada de IA: "mock" (default) ou "claude"
AI_PROVIDER=mock

# Necessário apenas quando AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
